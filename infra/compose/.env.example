POSTGRES_DB=ici_archivos
POSTGRES_USER=ici_migrator
POSTGRES_PASSWORD=change-me-local-only
ICI_APP_DB_USER=ici_app
ICI_APP_DB_PASSWORD=change-me-local-only
MINIO_ROOT_USER=ici_minio
MINIO_ROOT_PASSWORD=change-me-local-only
S3_ENDPOINT=http://127.0.0.1:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=ici_storage
S3_SECRET_ACCESS_KEY=change-me-local-only
S3_QUARANTINE_BUCKET=ici-quarantine
S3_CLEAN_BUCKET=ici-clean
S3_FORCE_PATH_STYLE=true

# The worker runs in the host process with `pnpm dev`; set these only when the
# worker is attached to the Compose network (where clamd is intentionally not
# published to the host).
# CLAMAV_HOST=clamav
# CLAMAV_PORT=3310
# CLAMAV_CONNECT_TIMEOUT_MS=5000
# CLAMAV_READ_TIMEOUT_MS=30000
# MALWARE_POLL_INTERVAL_MS=1000
# MALWARE_LEASE_SECONDS=300
