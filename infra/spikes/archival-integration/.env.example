# Browser/host endpoints
ATOM_URL=http://127.0.0.1:63001
ARCHIVEMATICA_URL=http://127.0.0.1:62080
STORAGE_SERVICE_URL=http://127.0.0.1:62081

# Bootstrap credentials are intentionally development-only.
ATOM_ADMIN_EMAIL=demo@example.com
ATOM_ADMIN_USERNAME=demo
ATOM_ADMIN_PASSWORD=demo
ATOM_API_KEY=

ARCHIVEMATICA_API_USERNAME=test
ARCHIVEMATICA_API_KEY=test
STORAGE_SERVICE_API_USERNAME=test
STORAGE_SERVICE_API_KEY=test

# Create this named profile in Archivematica before submitting a transfer.
ARCHIVEMATICA_PROCESSING_CONFIG=ici-mvp

# A new run ID should be used for every transfer attempt.
SPIKE_RUN_ID=ici-2026-000001
SPIKE_POLL_INTERVAL_SECONDS=10
SPIKE_POLL_TIMEOUT_SECONDS=1800

