{
  "name": "ici-archivos",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:packages": "pnpm --filter './packages/**' -r --if-present build",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "pnpm build:packages && concurrently -n api,web,worker -c blue,green,magenta \"pnpm --filter @ici/api dev\" \"pnpm --filter @ici/web dev\" \"pnpm --filter @ici/worker dev\"",
    "dev:api": "pnpm build:packages && pnpm --filter @ici/api dev",
    "dev:web": "pnpm --filter @ici/web dev",
    "dev:worker": "pnpm build:packages && pnpm --filter @ici/worker dev",
    "infra:up": "docker compose --env-file infra/compose/.env -f infra/compose/docker-compose.yml up -d",
    "infra:down": "docker compose --env-file infra/compose/.env -f infra/compose/docker-compose.yml down",
    "lint": "pnpm build:packages && eslint . --max-warnings=0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "typecheck": "pnpm build:packages && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@testcontainers/postgresql": "12.1.0",
    "@types/node": "26.5.0",
    "@vitest/coverage-v8": "5.0.0",
    "concurrently": "10.0.5",
    "eslint": "10.10.0",
    "globals": "17.12.0",
    "testcontainers": "12.1.0",
    "tsx": "4.23.13",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.0",
    "vitest": "5.0.0"
  }
}
